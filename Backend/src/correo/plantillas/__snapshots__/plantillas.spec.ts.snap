exports[`plantillas de correo (T-007.3h, C-5) anexo_vence_manana 1`] = `
{
  "asunto": "[SIAC] Certificado vence mañana",
  "html": "<!DOCTYPE html>
<html lang="es">
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#0A3B74">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:24px auto;background:#ffffff;border-radius:12px;border:1px solid #e2e8f0">
    <tr>
      <td style="padding:24px 28px 8px">
        <p style="margin:0;font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#1CBCA6">SIAC · CUAC</p>
        <h1 style="margin:12px 0 0;font-size:20px;font-weight:700">Un certificado vence mañana</h1>
      </td>
    </tr>
    <tr>
      <td style="padding:8px 28px 0">
        <span style="display:inline-block;padding:4px 10px;border-radius:999px;background:#0A3B74;color:#fff;font-size:11px;font-weight:600">Vigencia</span>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 28px 28px;font-size:15px;line-height:1.55;color:#334155">
        <p style="margin:0">El documento &quot;Certificado RETIE&quot; vence mañana (2026-10-17). Responsable: admin.planeacion@uniautonoma.edu.co.</p>
        <p style="margin:24px 0 0"><a href="https://siac.test/administrador/vigencias?programaId=prog-1" style="display:inline-block;padding:10px 18px;background:#0A3B74;color:#fff;text-decoration:none;border-radius:8px;font-weight:600">Revisar el certificado en SIAC</a></p>
        <p style="margin:28px 0 0;font-size:12px;color:#64748b">Recordatorio D-1 de vigencia del SIAC. Si el certificado se renueva, cárguelo de nuevo para mantener la vigencia al día.</p>
      </td>
    </tr>
  </table>
</body>
</html>",
  "texto": "El documento "Certificado RETIE" vence mañana (2026-10-17). Responsable: admin.planeacion@uniautonoma.edu.co.

Revisar el certificado en SIAC: https://siac.test/administrador/vigencias?programaId=prog-1",
}
`;

