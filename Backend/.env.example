# Postgres local (docker compose up -d en la raíz del repo)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siac"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/siac"

# JWT
JWT_SECRETO="CHANGE_ME_JWT_SECRET"
JWT_EXPIRACION="8h"

# Dominio institucional
DOMINIO_INSTITUCIONAL="uniautonoma.edu.co"

# Almacenamiento en disco (desarrollo). Producción: ruta/S3 institucional.
S3_USAR_ALMACEN_LOCAL="true"
ALMACEN_LOCAL_RUTA="./almacen-local"

# Supabase Storage (S3-compatible) solo si S3_USAR_ALMACEN_LOCAL="false"
S3_ENDPOINT="https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3"
S3_REGION="ca-central-1"
S3_BUCKET="evidencias"
S3_BUCKET_PLANTILLAS="plantillas"
S3_BUCKET_DOCUMENTOS="documentos"
S3_ACCESS_KEY="[SUPABASE_S3_ACCESS_KEY]"
S3_SECRET_KEY="[SUPABASE_S3_SECRET_KEY]"

# Integracion TI (opcional)
TI_API_URL=""
TI_API_TOKEN=""

# Catálogo de carreras CUAC (API externa)
CARRERAS_API_URL="https://backend-lac-theta-94.vercel.app/carreras"
CARRERAS_IMAGENES_BASE_URL="http://localhost:3000"

# Correo: desarrollo Resend; producción SMTP universidad (CORREO_CANAL=smtp)
CORREO_CANAL="resend"
RESEND_API_KEY=""
CORREO_DESDE="SIAC <notificaciones@tu-dominio-verificado.com>"
# Alias opcional (mismo efecto que CORREO_DESDE):
# CORREO_REMITENTE="SIAC <notificaciones@tu-dominio-verificado.com>"
# Modo prueba Resend: redirige todos los correos a tu cuenta (evita 403 a @institucional)
# RESEND_CORREO_SANDBOX="tu@gmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USUARIO=""
SMTP_CONTRASENA=""
SMTP_FROM="planeacion@uniautonoma.edu.co"

# Power BI Embedded (opcional)
POWERBI_CLIENT_ID=""
POWERBI_CLIENT_SECRET=""
POWERBI_TENANT_ID=""
POWERBI_WORKSPACE_ID=""
POWERBI_REPORT_ID=""
# Opcional (HU-009): URL de «Publicar en la web» del informe de Estudiantes (https://app.powerbi.com/view?r=...).
# ADVERTENCIA: el informe queda público en internet, sin autenticación. Vacía = respaldo Recharts.
POWERBI_URL_PUBLICA_ESTUDIANTES=""

# HU-009 — cifras institucionales: clave de integración para POST /api/v1/cifras/:categoriaId/ingesta
CIFRAS_API_KEY=""

# Servidor
PUERTO=3001
CORS_ORIGEN="http://localhost:3000"
