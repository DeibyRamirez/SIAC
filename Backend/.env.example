# =====================================================================
# SIAC Backend — variables de entorno (copiar a .env; NUNCA commitear .env)
# Producción: Render (ver docs/despliegue.md). Valores de ejemplo, sin secretos.
# =====================================================================

# --- Ejecución ---
# development | production (en Render: production)
NODE_ENV="development"
# Zona horaria del proceso (en Render: America/Bogota). El cron de vigencias ya fija America/Bogota.
# TZ="America/Bogota"
# Puerto local. Render inyecta PORT automáticamente (tiene prioridad sobre PUERTO).
PUERTO=3001
# PORT=10000

# --- Base de datos ---
# Local (docker compose up -d en la raíz del repo):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siac"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/siac"
# Supabase (Render, solo IPv4): pooler en modo transacción para la app y modo sesión para migraciones.
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Autenticación (obligatoria en producción: el arranque falla sin JWT_SECRETO) ---
JWT_SECRETO="CHANGE_ME_JWT_SECRET"
JWT_EXPIRACION="8h"
DOMINIO_INSTITUCIONAL="uniautonoma.edu.co"

# --- CORS y enlaces ---
# Lista separada por comas (dominio de Vercel y, si existe, dominio propio).
CORS_ORIGENES="http://localhost:3000"
# Nombre anterior (se sigue aceptando): CORS_ORIGEN="http://localhost:3000"
# URL pública del frontend: enlaces de los correos y origen CORS adicional.
FRONTEND_URL="http://localhost:3000"

# --- Almacenamiento ---
# Disco local solo en desarrollo. En Render debe ser "false" (el disco es efímero).
S3_USAR_ALMACEN_LOCAL="true"
ALMACEN_LOCAL_RUTA="./almacen-local"
# Supabase Storage (S3-compatible) si S3_USAR_ALMACEN_LOCAL="false"
S3_ENDPOINT="https://[PROJECT_REF].storage.supabase.co/storage/v1/s3"
S3_REGION="ca-central-1"
S3_BUCKET="evidencias"
S3_BUCKET_PLANTILLAS="plantillas"
S3_BUCKET_DOCUMENTOS="documentos"
S3_ACCESS_KEY="[SUPABASE_S3_ACCESS_KEY]"
S3_SECRET_KEY="[SUPABASE_S3_SECRET_KEY]"

# --- Correo: Resend (desarrollo/staging) o SMTP institucional (CORREO_CANAL=smtp) ---
CORREO_CANAL="resend"
RESEND_API_KEY=""
CORREO_DESDE="SIAC <notificaciones@tu-dominio-verificado.com>"
# Alias opcional (mismo efecto que CORREO_DESDE):
# CORREO_REMITENTE="SIAC <notificaciones@tu-dominio-verificado.com>"
# Modo prueba Resend: redirige todos los correos a una cuenta (evita 403 a @institucional sin dominio verificado)
# RESEND_CORREO_SANDBOX="tu@gmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USUARIO=""
SMTP_CONTRASENA=""
SMTP_FROM="planeacion@uniautonoma.edu.co"

# --- Power BI (HU-009, opcional) ---
POWERBI_CLIENT_ID=""
POWERBI_WORKSPACE_ID=""
POWERBI_REPORT_ID=""
# ID del informe de Estudiantes en el workspace App Owns Data.
POWERBI_REPORT_ID_ESTUDIANTES=""
# URL de «Publicar en la web» del informe de Estudiantes (https://app.powerbi.com/view?r=...).
# ADVERTENCIA: el informe queda público en internet, sin autenticación. Vacía = sin informe.
POWERBI_URL_PUBLICA_ESTUDIANTES=""
# Reservadas para App Owns Data (aún no las lee el código):
# POWERBI_CLIENT_SECRET=""
# POWERBI_TENANT_ID=""

# --- Integraciones externas (opcionales) ---
TI_API_URL=""
TI_API_TOKEN=""
# Catálogo de carreras CUAC (API externa)
CARRERAS_API_URL="https://backend-lac-theta-94.vercel.app/carreras"
# Base de las imágenes de programas (si falta, usa FRONTEND_URL y luego http://localhost:3000)
CARRERAS_IMAGENES_BASE_URL="http://localhost:3000"

# --- Vigencias: modo prueba acelerado (7 min ≈ 7 años por defecto; 300 s = 5 min) ---
# VIGENCIA_MODO_PRUEBA=true
# VIGENCIA_DURACION_PRUEBA_SEG=420
# VIGENCIA_INTERVALO_PRUEBA_SEG=10
# Con NODE_ENV=production el arranque falla si VIGENCIA_MODO_PRUEBA está activo, salvo que se
# declare explícitamente esta bandera (solo para un despliegue de staging/verificación):
# VIGENCIA_MODO_PRUEBA_PERMITIR_PRODUCCION=true

# --- Solo pruebas E2E ---
# SIAC_E2E_PERMITIR_BD_REMOTA=true  (por defecto las E2E solo corren contra localhost)
