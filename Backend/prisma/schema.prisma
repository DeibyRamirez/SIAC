generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  Cargador
  Revisor
  ParAcademico
  Administrador
  SuperAdmin
}

/// HU-003 (D1): tras el checklist, n < total => ConObservaciones y n = total => Cumple.
/// Validado y Rechazado quedan para la decisión explícita del Revisor (HU-006).
enum EstadoEvidencia {
  Borrador
  EnRevision
  Validado
  Rechazado
  ConObservaciones
  Cumple
}

enum EstadoVigencia {
  Vigente
  Proximo
  Vencido
}

enum FormatoArchivo {
  PDF
  DOCX
  XLSX
}

enum CategoriaPlantilla {
  Institucional
  Programa
  Autoevaluacion
}

enum TipoTramitePlantilla {
  Renovacion
  NuevoPrograma
  General
}

enum CodigoDocumentoGuia {
  G1
  G2
  G3
  G4
}

enum TipoTramiteSIAC {
  RegistroCalificadoNuevo
  RenovacionRegistroCalificado
  CondicionesInstitucionalesNuevas
  RenovacionCondicionesInstitucionales
}

enum AlcanceTramiteSIAC {
  Programa
  Institucion
}

enum CodigoCondicionDocumentoMaestro {
  Denominacion
  Justificacion
  AspectosCurriculares
  OrganizacionActividades
  InvestigacionInnovacion
  RelacionSectorExterno
  Profesores
  MediosEducativos
  Infraestructura
}

enum CodigoCondicionInstitucional {
  SeleccionEvaluacionEstudiantesProfesores
  EstructuraAdministrativaAcademica
  CulturaAutoevaluacion
  ProgramaEgresados
  ModeloBienestar
  RecursosSuficientes
}

enum OrigenDato {
  API
  CSV
  Manual
}

model Usuario {
  id                   String        @id @default(cuid())
  codigoInstitucional  String?       @db.VarChar(50)
  nombre               String        @db.VarChar(255)
  correo               String        @unique @db.VarChar(255)
  contrasena           String        @db.VarChar(255)
  cargo                String?       @db.VarChar(150)
  dependencia          String?       @db.VarChar(150)
  rol                  RolUsuario
  activo               Boolean       @default(true)
  idExterno            String?       @unique @db.VarChar(100)
  origenDato           OrigenDato    @default(Manual)
  fechaSincronizacion  DateTime?
  evidencias           Evidencia[]
  versionesEvidencia   EvidenciaVersion[]
  alertas              AlertaInApp[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  usuarioProgramas UsuarioPrograma[]
}

model Programa {
  id                  String          @id @default(cuid())
  nombre              String          @db.VarChar(200)
  codigo              String          @unique @db.VarChar(20)
  codigoSnies         String?         @db.VarChar(20)
  nivel               String          @db.VarChar(50)
  modalidad           String?         @db.VarChar(50)
  duracionSemestres   Int?
  facultad            String?         @db.VarChar(200)
  slug                String          @unique @db.VarChar(160)
  urlImagen           String?         @db.VarChar(500)
  tipoTramiteActivo   TipoTramiteSIAC @default(RenovacionRegistroCalificado)
  activo              Boolean         @default(true)
  semaforo            String          @default("Verde") @db.VarChar(20)
  porcentajeAvance    Float           @default(0)
  estadoProceso       String          @default("En progreso") @db.VarChar(50)
  idExterno           String?         @unique @db.VarChar(100)
  origenDato          OrigenDato      @default(Manual)
  fechaSincronizacion DateTime?
  evidencias          Evidencia[]
  anexos              AnexoVigencia[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  usuarioProgramas UsuarioPrograma[]
}

model UsuarioPrograma {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  programaId String
  programa   Programa @relation(fields: [programaId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([usuarioId, programaId])
  @@index([programaId])
}

model Evidencia {
  id            String               @id @default(cuid())
  nombre        String               @db.VarChar(300)
  programaId    String
  programa      Programa             @relation(fields: [programaId], references: [id])
  periodo       String               @db.VarChar(100)
  factor        String               @db.VarChar(100)
  indicador     String               @db.VarChar(200)
  estado        EstadoEvidencia      @default(Borrador)
  autorId       String
  autor         Usuario              @relation(fields: [autorId], references: [id])
  nombreArchivo String               @db.VarChar(255)
  rutaArchivo   String?              @db.VarChar(500)
  mimeType      String?              @db.VarChar(100)
  tamanoBytes   Int?
  version       Int                  @default(1)
  fechaCarga    DateTime             @default(now())
  observaciones String?
  responsable   String?              @db.VarChar(150)
  documentoRequeridoId   String?
  documentoRequerido     DocumentoRequerido? @relation(fields: [documentoRequeridoId], references: [id])
  /// Heredado del modelo anterior (porcentaje). Ya no se escribe para documentos con checklist; se retira en T-003.3.
  porcentajeCompletitud  Float               @default(0)
  requiereChecklistMaestro Boolean           @default(false)
  codigoGuia             CodigoDocumentoGuia?
  /// Puntaje entero n de la última verificación (condiciones que cumplen).
  puntajeActual          Int?
  /// Total de condiciones evaluadas en la última verificación (9 en G1, 6 en G3).
  totalCondicionesActual Int?
  historial                HistorialEvidencia[]
  versiones                EvidenciaVersion[]
  evaluacionesCondicion    EvaluacionCondicionEvidencia[]
  comentarios              EvidenciaComentario[]
  evaluacionesCondicionInstitucional EvaluacionCondicionInstitucionalEvidencia[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([programaId])
  @@index([documentoRequeridoId])
  @@index([autorId])
  @@index([estado])
  @@index([puntajeActual])
  @@index([factor, indicador, periodo])
}

model EvidenciaVersion {
  id            String    @id @default(cuid())
  evidenciaId   String
  evidencia     Evidencia @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  numero        Int
  nombreArchivo String    @db.VarChar(255)
  rutaArchivo   String    @db.VarChar(500)
  mimeType      String?   @db.VarChar(100)
  tamanoBytes        Int?
  firmaDescarga      String?   @db.VarChar(500)
  textoBaseAuditoria String?   @db.Text
  subidoPorId        String
  subidoPor          Usuario   @relation(fields: [subidoPorId], references: [id])
  createdAt          DateTime  @default(now())

  @@unique([evidenciaId, numero])
  @@index([evidenciaId])
}

model EvidenciaComentario {
  id            String    @id @default(cuid())
  evidenciaId   String
  evidencia     Evidencia @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  numeroVersion Int
  revisorId     String?
  autor         String?   @db.VarChar(255)
  hunkId        String?   @db.VarChar(100)
  anchor        String?   @db.VarChar(100)
  quote         String?
  texto         String
  createdAt     DateTime  @default(now())

  @@index([evidenciaId, numeroVersion])
}

model HistorialEvidencia {
  id          String          @id @default(cuid())
  evidenciaId String
  evidencia   Evidencia       @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  estado      EstadoEvidencia
  observacion String?
  actorId     String?
  createdAt   DateTime        @default(now())

  @@index([actorId, createdAt])
}

model Plantilla {
  id                     String               @id @default(cuid())
  nombre                 String               @db.VarChar(200)
  factor                 String               @db.VarChar(100)
  formato                FormatoArchivo
  version                String               @db.VarChar(20)
  vigente                Boolean              @default(true)
  categoria              CategoriaPlantilla
  tipoTramite            TipoTramitePlantilla @default(General)
  codigoGuia             CodigoDocumentoGuia?
  esGuiaDocumentoMaestro Boolean              @default(false)
  descripcion            String?
  nombreArchivo          String?              @db.VarChar(255)
  rutaArchivo            String?              @db.VarChar(500)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([factor, vigente])
  @@index([categoria, tipoTramite])
}

model EvaluacionCondicionEvidencia {
  id              String                        @id @default(cuid())
  evidenciaId     String
  evidencia       Evidencia                     @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  numeroRevision  Int
  codigoCondicion CodigoCondicionDocumentoMaestro
  cumple          Boolean
  observacion     String?
  revisorId       String?
  createdAt       DateTime                      @default(now())

  @@unique([evidenciaId, numeroRevision, codigoCondicion])
  @@index([evidenciaId])
}

model EvaluacionCondicionInstitucionalEvidencia {
  id              String                      @id @default(cuid())
  evidenciaId     String
  evidencia       Evidencia                   @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  numeroRevision  Int
  codigoCondicion CodigoCondicionInstitucional
  cumple          Boolean
  observacion     String?
  revisorId       String?
  createdAt       DateTime                    @default(now())

  @@unique([evidenciaId, numeroRevision, codigoCondicion])
  @@index([evidenciaId])
}

model AnexoVigencia {
  id               String         @id @default(cuid())
  titulo           String         @db.VarChar(200)
  programaId       String
  programa         Programa       @relation(fields: [programaId], references: [id])
  tipo             String         @db.VarChar(100)
  carpeta          String         @default("general") @db.VarChar(150)
  nombreArchivo    String?        @db.VarChar(255)
  rutaArchivo      String?        @db.VarChar(500)
  mimeType         String?        @db.VarChar(100)
  aniosVigencia    Int            @default(7)
  fechaCarga       DateTime       @default(now())
  fechaVencimiento DateTime
  estado           EstadoVigencia @default(Vigente)
  responsable      String         @db.VarChar(150)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([programaId])
  @@index([fechaVencimiento])
  @@index([carpeta])
}

model AlertaInApp {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  mensaje   String
  leida     Boolean  @default(false)
  tipo      String   @default("general") @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([usuarioId, leida])
}

model TramiteSIAC {
  id         String              @id @default(cuid())
  tipo       TipoTramiteSIAC     @unique
  alcance    AlcanceTramiteSIAC
  nombre     String              @db.VarChar(200)
  activo     Boolean             @default(true)
  documentos TramiteDocumentoGuia[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model TramiteDocumentoGuia {
  id         String              @id @default(cuid())
  tramiteId  String
  tramite    TramiteSIAC         @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  codigoGuia CodigoDocumentoGuia
  orden      Int                 @default(0)

  @@unique([tramiteId, codigoGuia])
  @@index([tramiteId])
}

model EtapaAcreditacion {
  id          String             @id @default(cuid())
  nombre      String             @db.VarChar(200)
  tipo        String             @db.VarChar(100)
  descripcion String
  orden       Int
  activa      Boolean            @default(true)
  carpetas    CarpetaNormativa[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model CarpetaNormativa {
  id          String               @id @default(cuid())
  etapaId     String
  etapa       EtapaAcreditacion    @relation(fields: [etapaId], references: [id])
  condicionId String?
  nombre      String               @db.VarChar(200)
  descripcion String
  orden       Int
  activa      Boolean              @default(true)
  documentos  DocumentoRequerido[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model DocumentoRequerido {
  id                     String           @id @default(cuid())
  carpetaId              String
  carpeta                CarpetaNormativa @relation(fields: [carpetaId], references: [id])
  nombre                 String           @db.VarChar(200)
  esPlantilla            Boolean          @default(false)
  formato                FormatoArchivo
  obligatorio            Boolean          @default(true)
  requiereChecklistMaestro Boolean        @default(false)
  codigoGuia             CodigoDocumentoGuia?
  orden                  Int
  evidencias             Evidencia[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}
