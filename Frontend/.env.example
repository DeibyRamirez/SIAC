# =====================================================================
# SIAC Frontend — variables de entorno (Vercel: Settings → Environment Variables)
# Local: copiar a .env.local. NUNCA commitear .env, .env.local ni .env.production.
# =====================================================================

# URL del backend NestJS que usa el BFF (servidor de Next: app/api/sesion y app/api/v1).
# Obligatoria en producción (Vercel): URL de Render + /api/v1. En desarrollo, si falta,
# se usa http://localhost:3001/api/v1.
API_URL_INTERNAL=http://localhost:3001/api/v1

# Respaldo histórico de API_URL_INTERNAL (se incrusta en el build). El navegador no la usa:
# siempre llama al BFF relativo /api/v1 del mismo dominio.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Power BI (HU-009). Modo: publico (por defecto) | embebido (App Owns Data, bloqueado hasta tener credenciales Azure)
# Se lee en el build (next.config.mjs).
POWERBI_MODO=publico
# Las URL de «Publicar en la web» se configuran en el dashboard (panel admin) y viven en ConfiguracionInformePowerBi.
# ADVERTENCIA: «Publicar en la web» deja el informe público en internet, sin autenticación.

# Simulación UI: barra de vigencia acelerada en detalle de programa/institución.
# Solo para staging junto con VIGENCIA_MODO_PRUEBA en el backend. Se incrusta en el build.
# NEXT_PUBLIC_DEMO_VIGENCIA_7MIN=true
