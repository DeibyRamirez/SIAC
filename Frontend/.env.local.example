# API Backend SIAC (versión F-03)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Power BI (HU-009). Modo: publico (por defecto) | embebido (App Owns Data, bloqueado hasta tener credenciales Azure)
POWERBI_MODO=publico
# URL de «Publicar en la web» por categoría. Deben empezar por https://app.powerbi.com/view?r=
# ADVERTENCIA: «Publicar en la web» deja el informe público en internet, sin autenticación.
NEXT_PUBLIC_POWERBI_URL_ASEGURAMIENTO=
NEXT_PUBLIC_POWERBI_URL_INFRAESTRUCTURA=
NEXT_PUBLIC_POWERBI_URL_EGRESADOS=
NEXT_PUBLIC_POWERBI_URL_INVESTIGACION=
NEXT_PUBLIC_POWERBI_URL_PROFESORES=
NEXT_PUBLIC_POWERBI_URL_ESTUDIANTES=
