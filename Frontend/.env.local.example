# API Backend SIAC (desarrollo local; ver .env.example para la lista completa)
API_URL_INTERNAL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Simulación UI: barra de vigencia 7 min ~ 7 años en detalle de programa/institución (solo desarrollo)
# NEXT_PUBLIC_DEMO_VIGENCIA_7MIN=true

# Power BI (HU-009). Modo: publico (por defecto) | embebido (App Owns Data, bloqueado hasta tener credenciales Azure)
POWERBI_MODO=publico
# URL por categoría: panel «Actualizar informes Power BI» en el dashboard de administrador (BD).
